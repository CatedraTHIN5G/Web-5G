---
import { withBase } from "../utils/urls";
import { SITE, LOGO_IMAGE } from "../config";
import { ChevronDown, Menu, Moon, Search, Sun, X } from "lucide-react";
import { languages } from "../i18n/ui";

const { nav, i18n, customPages } = SITE;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const home = withBase("/").replace(/\/$/, "") || "/";
const isCurrent = (href: string) => {
  const target = withBase(href).replace(/\/$/, "") || "/";
  return current === target || (target !== home && current.startsWith(target + "/"));
};
---

<header class="site-header sticky top-0 z-50 w-full">
  <div class="site-frame site-header-row">
    <a href={withBase("/")} class="site-header-brand" aria-label="Cátedra THIN5G">
      {
        LOGO_IMAGE.enable && SITE.logo && (
          <>
            <img src={withBase(SITE.logo)} alt="Logo" class="w-auto object-contain dark:hidden" />
            <img src={withBase("/footer/logoCatedra_dark.svg")} alt="Logo Dark" class="w-auto object-contain hidden dark:block" />
          </>
        )
      }
    </a>

    <nav class="site-nav hidden lg:flex items-center">
      {
        nav.map((item) =>
          item.key === "search" ? (
            <a href={withBase(item.link)} class="site-header-button" aria-label={item.text}>
              <Search aria-hidden="true" size={20} />
            </a>
          ) : (
            <a
              href={withBase(item.link)}
              class="site-nav-link"
              aria-current={isCurrent(item.link) ? "page" : undefined}
              data-i18n-key={`nav.${item.key}`}
            >
              {item.text}
            </a>
          ),
        )
      }
      {
        customPages?.map((item) => (
          <a
            href={withBase(item.link)}
            class="site-nav-link"
            aria-current={isCurrent(item.link) ? "page" : undefined}
            data-i18n-key={item.key}
          >
            {item.text}
          </a>
        ))
      }
      {
        i18n.enabled && (
          <div class="site-languages">
            <button type="button" class="lang-option-toggle" data-lang="es" data-active="false" aria-label="Español">
              <img src="https://flagcdn.com/w40/es.png" srcset="https://flagcdn.com/w80/es.png 2x" width="20" alt="España" />
              <span>ES</span>
            </button>
            <button type="button" class="lang-option-toggle" data-lang="en" data-active="true" aria-label="English">
              <img src="https://flagcdn.com/w40/gb.png" srcset="https://flagcdn.com/w80/gb.png 2x" width="20" alt="United Kingdom" />
              <span>EN</span>
            </button>
          </div>
        )
      }
    </nav>

    <button
      type="button"
      id="theme-toggle"
      class="site-header-button"
      aria-label="Toggle dark mode"
      aria-pressed="false"
    >
      <Moon aria-hidden="true" size={21} className="theme-moon" />
      <Sun aria-hidden="true" size={21} className="theme-sun" />
    </button>
    <button
      type="button"
      id="mobile-menu-btn"
      class="site-header-button lg:hidden"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <Menu aria-hidden="true" size={23} />
    </button>
  </div>

  <!-- Mobile Nav Overlay (Solid White) -->
  <div
    id="mobile-menu"
    class="site-mobile-menu fixed inset-0 z-[100] w-full lg:hidden hidden flex-col"
    style="display: none;"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="mobile-menu-title"
  >
    <!-- Header with Close Button -->
    <div
      class="flex items-center justify-between px-6 h-20 border-b border-gray-100 shrink-0 bg-white"
    >
      <div class="flex items-center gap-3">
        {
          LOGO_IMAGE.enable && SITE.logo && (
            <>
              <img src={withBase(SITE.logo)} alt="Logo" class="h-10 w-10 object-contain dark:hidden" />
              <img src={withBase("/footer/logoCatedra_dark.svg")} alt="Logo Dark" class="h-10 w-10 object-contain hidden dark:block" />
            </>
          )
        }
        <span id="mobile-menu-title" class="font-semibold text-xl">{SITE.labName}</span>
      </div>
      <button
        onclick="window.closeMobileMenu()"
        class="site-header-button"
        aria-label="Close menu"
      >
        <X className="w-8 h-8" />
      </button>
    </div>

    <!-- Scrollable Menu Content -->
    <nav class="flex-1 overflow-y-auto px-6 py-8 flex flex-col gap-2 bg-white">
      {
        nav.map((item) => (
          <a
            href={withBase(item.link)}
            class="flex items-center justify-between w-full py-3 border-b border-gray-100 last:border-0"
            aria-current={isCurrent(item.link) ? "page" : undefined}
            data-i18n-key={`nav.${item.key}`}
          >
            <span>{item.text}</span>
            <ChevronDown className="w-5 h-5 -rotate-90 text-gray-400" />
          </a>
        ))
      }

      <!-- Custom Pages Mobile -->
      {
        customPages &&
          customPages.map((item) => (
            <a
              href={withBase(item.link)}
              class="flex items-center justify-between w-full py-3 border-b border-gray-100 last:border-0"
              aria-current={isCurrent(item.link) ? "page" : undefined}
              data-i18n-key={item.key}
            >
              <span>{item.text}</span>
              <ChevronDown className="w-5 h-5 -rotate-90 text-gray-400" />
            </a>
          ))
      }

      {
        i18n.enabled && (
          <div class="mt-8 pt-6 border-t border-gray-100">
            <div class="mobile-menu-label text-sm font-bold mb-4 px-2">
              Language
            </div>
            <div class="grid grid-cols-2 gap-3">
              {Object.entries(languages).map(([code, label]) => (
                <button
                  class="px-4 py-3 rounded-xl text-base font-medium border border-gray-200 text-gray-600 hover:border-blue-600 hover:text-blue-600 hover:bg-blue-50 transition-all lang-option mobile-lang-option text-center"
                  data-lang={code}
                  onclick="window.setLanguage && window.setLanguage(this.getAttribute('data-lang')); window.closeMobileMenu()"
                >
                  {label}
                </button>
              ))}
            </div>
          </div>
        )
      }
    </nav>

    <!-- Footer Info -->
    <div class="p-8 bg-gray-50 shrink-0 border-t border-gray-200">
      <p class="mobile-menu-footer text-sm font-medium text-center">
        © {new Date().getFullYear()}
        {SITE.labName}
      </p>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const button = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const desktop = window.matchMedia("(min-width: 64rem)");

    function setMenu(open, restoreFocus = true) {
      if (!button || !menu) return;
      button.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-hidden", String(!open));
      menu.style.display = open ? "flex" : "none";
      menu.classList.toggle("hidden", !open);
      document.body.classList.toggle("overflow-hidden", open);

      if (open) {
        menu.querySelector("a")?.focus();
      } else if (restoreFocus) {
        button.focus();
      }
    }

    window.closeMobileMenu = () => setMenu(false);
    button?.addEventListener("click", () => setMenu(button.getAttribute("aria-expanded") !== "true"));

    document.addEventListener("keydown", (event) => {
      if (button?.getAttribute("aria-expanded") !== "true") return;
      if (event.key === "Escape") {
        event.preventDefault();
        setMenu(false);
      } else if (event.key === "Tab" && menu) {
        const controls = [...menu.querySelectorAll("a[href], button:not([disabled])")];
        const first = controls[0];
        const last = controls.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    desktop.addEventListener("change", (event) => {
      if (event.matches && button?.getAttribute("aria-expanded") === "true") {
        setMenu(false, false);
      }
    });

    function updateHeaderLanguage(lang) {
      document.querySelectorAll(".lang-option-toggle, .lang-option").forEach((option) => {
        const active = option.getAttribute("data-lang") === lang;
        option.setAttribute("data-active", String(active));
        option.setAttribute("aria-pressed", String(active));
      });
    }

    window.addEventListener("language-change", (event) => {
      updateHeaderLanguage(event.detail.lang);
    });
    updateHeaderLanguage(localStorage.getItem("preferred-lang") || document.documentElement.lang);

    document.querySelectorAll(".lang-option-toggle").forEach((option) => {
      option.addEventListener("click", () => {
        window.setLanguage?.(option.getAttribute("data-lang"));
      });
    });

    const root = document.documentElement;
    const themeToggle = document.getElementById("theme-toggle");
    if (themeToggle) {
      themeToggle.setAttribute("aria-pressed", String(root.classList.contains("dark")));
      themeToggle.addEventListener("click", () => {
        const dark = root.classList.toggle("dark");
        themeToggle.setAttribute("aria-pressed", String(dark));
        localStorage.setItem("theme", dark ? "dark" : "light");
      });
    }
  })();
</script>
