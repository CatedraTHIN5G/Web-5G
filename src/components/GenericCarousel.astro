---
import { withBase } from "../utils/urls";
interface Props {
    images: string[];
    className?: string; // Optional wrapper class
    overlay?: boolean; // Whether to show the dark gradient overlay
    interval?: number; // Slide interval in ms
}

const {
    images,
    className = "h-full w-full",
    overlay = true,
    interval = 5000,
} = Astro.props;

// Safe fallback
const safeImages = images && images.length > 0 ? images : ["/footer/placeholder.svg"];
// Unique ID to allow multiple carousels on one page without script conflicts
const carouselId = `carousel-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={`relative overflow-hidden ${className}`} id={carouselId}>
    {
        safeImages.map((img, index) => (
            <div
                class={`absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
                data-slide-index={index}
            >
                <img
                    src={withBase(img)}
                    alt={`Slide ${index + 1}`}
                    class="w-full h-full object-cover"
                />
                {/* Optional Overlay */}
                {overlay && (
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
                )}
            </div>
        ))
    }
</div>

<script define:vars={{ carouselId, interval }}>
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById(carouselId);
        if (!container) return;

        const slides = container.querySelectorAll("[data-slide-index]");

        if (slides.length <= 1) return;

        let currentIndex = 0;

        setInterval(() => {
            // Fade out current
            const currentSlide = slides[currentIndex];

            currentSlide.classList.remove("opacity-100", "z-10");
            currentSlide.classList.add("opacity-0", "z-0");

            // Next index
            currentIndex = (currentIndex + 1) % slides.length;

            // Fade in next
            const nextSlide = slides[currentIndex];

            nextSlide.classList.remove("opacity-0", "z-0");
            nextSlide.classList.add("opacity-100", "z-10");
        }, interval);
    });
</script>
