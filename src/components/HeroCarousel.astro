---
import { withBase } from "../utils/urls";
import { ArrowLeft, ArrowRight, Pause, Play } from "lucide-react";

interface Props {
  images: string[];
  autoplay?: boolean;
}

const { images, autoplay = true } = Astro.props;
const photos = (images.length ? images : ["/footer/placeholder.svg"]).map(withBase);
const formatNumber = (number: number) => String(number).padStart(2, "0");
---

<div class="lab-gallery" data-lab-gallery>
  <div class="lab-gallery-photos">
    {
      photos.map((photo, index) => (
        <img
          src={index === 0 ? photo : undefined}
          data-src={index === 0 ? undefined : photo}
          alt={index === 0 ? "Equipment on display at the THIN5G Open Lab" : `THIN5G Open Lab, ${index + 1}`}
          aria-hidden={index === 0 ? "false" : "true"}
          data-visible={index === 0 ? "true" : "false"}
          loading={index === 0 && !autoplay ? "lazy" : undefined}
          fetchpriority={index === 0 && autoplay ? "high" : undefined}
          decoding="async"
        />
      ))
    }
  </div>
  {photos.length > 1 && (
    <div class="lab-gallery-controls" hidden>
      <p class="lab-gallery-count" aria-hidden="true">
        <span data-gallery-count>{formatNumber(1)}</span> / {formatNumber(photos.length)}
      </p>
      <div class="lab-gallery-buttons">
        <button type="button" data-gallery-previous>
          <ArrowLeft aria-hidden="true" size={20} />
          <span class="sr-only i18n-content-en">Previous photo</span>
          <span class="sr-only i18n-content-es">Foto anterior</span>
        </button>
        <button type="button" data-gallery-next>
          <ArrowRight aria-hidden="true" size={20} />
          <span class="sr-only i18n-content-en">Next photo</span>
          <span class="sr-only i18n-content-es">Siguiente foto</span>
        </button>
        {autoplay && <button type="button" data-gallery-pause aria-pressed="false">
          <Pause aria-hidden="true" size={17} className="gallery-pause-icon" />
          <Play aria-hidden="true" size={17} className="gallery-play-icon" />
          <span class="sr-only i18n-content-en">Pause slideshow</span>
          <span class="sr-only i18n-content-es">Pausar presentación</span>
        </button>}
      </div>
    </div>
  )}
</div>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-lab-gallery]");
  const controls = gallery?.querySelector<HTMLElement>(".lab-gallery-controls");

  if (gallery && controls) {
    const photos = [...gallery.querySelectorAll<HTMLImageElement>(".lab-gallery-photos img")];
    const count = controls.querySelector<HTMLElement>("[data-gallery-count]");
    const pause = controls.querySelector<HTMLButtonElement>("[data-gallery-pause]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let requested = 0;
    let playing = Boolean(pause) && !reducedMotion.matches;
    let timer: number | undefined;

    async function showPhoto(index: number) {
      requested = (index + photos.length) % photos.length;
      const next = requested;
      const photo = photos[next];
      if (photo.dataset.src) {
        photo.src = photo.dataset.src;
        delete photo.dataset.src;
      }

      try {
        await photo.decode();
      } catch {
        return;
      }
      if (next !== requested) return;

      photos[current].dataset.visible = "false";
      photos[current].setAttribute("aria-hidden", "true");
      photo.dataset.visible = "true";
      photo.setAttribute("aria-hidden", "false");
      current = next;
      if (count) count.textContent = String(current + 1).padStart(2, "0");
    }

    function stopTimer() {
      window.clearInterval(timer);
    }

    function updateTimer() {
      stopTimer();
      pause?.setAttribute("aria-pressed", String(!playing));
      if (playing && !document.hidden && !gallery?.matches(":hover, :focus-within")) {
        timer = window.setInterval(() => void showPhoto(requested + 1), 6500);
      }
    }

    controls.querySelector("[data-gallery-previous]")?.addEventListener("click", () => {
      void showPhoto(requested - 1);
    });
    controls.querySelector("[data-gallery-next]")?.addEventListener("click", () => {
      void showPhoto(requested + 1);
    });
    pause?.addEventListener("click", () => {
      playing = !playing;
      updateTimer();
    });
    reducedMotion.addEventListener("change", (event) => {
      playing = Boolean(pause) && !event.matches;
      updateTimer();
    });
    gallery.addEventListener("pointerenter", stopTimer);
    gallery.addEventListener("pointerleave", updateTimer);
    gallery.addEventListener("focusin", stopTimer);
    gallery.addEventListener("focusout", () => window.setTimeout(updateTimer));
    document.addEventListener("visibilitychange", updateTimer);

    controls.hidden = false;
    updateTimer();
  }
</script>
