---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import {
    Mail,
    Globe,
    Twitter,
    GraduationCap,
    ArrowLeft,
    Linkedin,
    Github,
} from "lucide-react";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
    const teamMembers = await getCollection("team");
    return teamMembers.map((member) => ({
        params: { slug: member.id.replace(/\.[^/.]+$/, "") },
        props: { member },
    }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { slug } = Astro.params;
let { member } = Astro.props;

if (!member && slug) {
    // Fallback for SSR/Preview where props might be missing
    try {
        member = (await getEntry("team", slug)) as any;
    } catch (e) {
        console.error(`Error fetching team member for slug: ${slug}`, e);
    }
}

if (!member) {
    return Astro.redirect("/404");
}

const { Content } = await render(member);
const {
    name,
    role,
    title,
    avatar,
    email,
    website,
    linkedin,
    github,
    twitter,
    googleScholar,
} = member.data;

const roleToKey: Record<string, string> = {
    "Principal Investigator": "role.pi",
    Professor: "role.professor",
    "Associate Professor": "role.titular",
    "Assistant Professor": "role.assistant",
    Teacher: "role.assistant",
    "Postdoctoral Researcher": "role.postdoc",
    Postdoc: "role.postdoc",
    "Research Assistant": "role.research_assistant",
    "PhD Student": "role.phd",
    "Master Student": "role.master",
    "Graduate Student": "role.master",
    Undergraduate: "role.undergrad",
    Student: "role.student",
    "Former Member": "role.alumni",
    Alumni: "role.alumni",
    Director: "role.director",
    "Co-Director": "role.codirector",
    Doctor: "role.doctor",
    Investigador: "role.researcher",
    "Ramón y Cajal Researcher": "role.ryc",
    "Project Researcher": "role.project_researcher",
    "Professor / Associate Professor": "role.cate_titular",
    "Professor / Ramón y Cajal Researcher": "role.cate_ryc",
};

const translatedRole = roleToKey[role] ? t(roleToKey[role] as any) : role;
---

<Layout title={name}>
    <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
        <a
            href="/team"
            class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 mb-8 transition-colors"
        >
            <ArrowLeft className="w-4 h-4 mr-1" /> Back to Team
        </a>
        <div
            class="bg-white dark:bg-gray-900 rounded-3xl p-8 border border-gray-100 dark:border-gray-800 shadow-sm mb-12"
        >
            <div class="flex flex-col md:flex-row gap-8 items-start">
                <div
                    class="w-32 h-32 md:w-48 md:h-48 rounded-2xl overflow-hidden bg-gray-100 shrink-0 mx-auto md:mx-0 relative"
                >
                    {
                        member.data.status && (
                            <div
                                class={`absolute top-2 right-2 z-10 px-2 py-0.5 rounded-full text-[10px] font-bold text-white shadow-sm
                                ${
                                    member.data.status === "active"
                                        ? "bg-green-500"
                                        : member.data.status === "inactive"
                                          ? "bg-gray-500"
                                          : member.data.status === "affiliate"
                                            ? "bg-blue-500"
                                            : "bg-gray-500"
                                }`}
                                data-i18n-key={`team.filter.${member.data.status}`}
                            >
                                {member.data.status.charAt(0).toUpperCase() +
                                    member.data.status.slice(1)}
                            </div>
                        )
                    }
                    <img
                        src={avatar}
                        alt={name}
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="flex-grow text-center md:text-left">
                    <h1
                        class="text-3xl font-bold text-gray-900 dark:text-white mb-2"
                    >
                        {name}
                    </h1>
                    <p
                        class="text-xl text-blue-600 dark:text-blue-400 font-medium mb-6"
                        data-i18n-key={roleToKey[role]}
                    >
                        {translatedRole}
                    </p>
                    <div
                        class="flex flex-wrap justify-center
    md:justify-start gap-3"
                    >
                        {
                            email && (
                                <a
                                    href={`mailto:${email}`}
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <Mail className="w-4 h-4" />{" "}
                                    <span>Email</span>{" "}
                                </a>
                            )
                        }
                        {
                            website && (
                                <a
                                    href={website}
                                    target="_blank"
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <Globe className="w-4 h-4" />{" "}
                                    <span>Website</span>
                                </a>
                            )
                        }
                        {
                            linkedin && (
                                <a
                                    href={linkedin}
                                    target="_blank"
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <Linkedin className="w-4 h-4" />{" "}
                                    <span>LinkedIn</span>{" "}
                                </a>
                            )
                        }
                        {
                            github && (
                                <a
                                    href={github}
                                    target="_blank"
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <Github className="w-4 h-4" />{" "}
                                    <span>GitHub</span>
                                </a>
                            )
                        }
                        {
                            twitter && (
                                <a
                                    href={twitter}
                                    target="_blank"
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <Twitter className="w-4 h-4" />{" "}
                                    <span>Twitter</span>{" "}
                                </a>
                            )
                        }
                        {
                            googleScholar && (
                                <a
                                    href={googleScholar}
                                    target="_blank"
                                    class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-blue-50 dark:hover:bg-blue-900/30 hover:text-blue-600 dark:hover:text-blue-400 transition-colors text-sm"
                                >
                                    {" "}
                                    <GraduationCap className="w-4 h-4" />
                                    <span>Scholar</span>{" "}
                                </a>
                            )
                        }
                    </div>
                    {
                        title && title.length > 0 && (
                            <div class="flex flex-wrap justify-center md:justify-start gap-2 mt-4">
                                {title.map((tItem) => (
                                    <span
                                        class="bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 text-xs px-2.5 py-0.5 rounded border border-blue-200 dark:border-blue-800"
                                        data-i18n-key={roleToKey[tItem]}
                                    >
                                        {" "}
                                        {roleToKey[tItem]
                                            ? t(roleToKey[tItem] as any)
                                            : tItem}{" "}
                                    </span>
                                ))}{" "}
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
        <div
            class="prose prose-lg prose-blue dark:prose-invert max-w-none text-gray-700 dark:text-gray-300"
        >
            <Content />
        </div>
    </div>
</Layout>
