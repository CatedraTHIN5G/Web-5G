---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Calendar, ArrowRight } from "lucide-react";

const events = (await getCollection("events")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Events">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="mb-16">
      <h1
        class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4"
        data-i18n-key="events.title"
      >
        Team Events
      </h1>
      <p
        class="text-lg text-gray-600 dark:text-gray-400"
        data-i18n-key="events.subtitle"
      >
        Workshops, seminars, and outreach events.
      </p>
    </div>

    <!-- Events Gallery -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mb-20">
      <!-- Left Column: Timeline -->
      <div class="lg:col-span-2">
        <h2
          class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8"
          data-i18n-key="events.timeline"
        >
          Activity Timeline
        </h2>

        <div class="relative space-y-8 pl-4">
          <!-- Vertical Line -->
          <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700"></div>

          {events.map((item, index) => (
            <div class="relative pl-10 group">
              <!-- Dot -->
              <div class="absolute left-2.5 top-2 w-3 h-3 bg-blue-600 rounded-full border-2 border-white dark:border-gray-900 z-10 group-hover:scale-125 transition-transform"></div>
              
              <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-all">
                <div class="flex flex-col sm:flex-row gap-6">
                   <!-- Date & Image -->
                   <div class="sm:w-1/3 flex-shrink-0">
                      <time class="text-sm font-bold text-blue-600 dark:text-blue-400 mb-2 block uppercase tracking-wider">
                        {new Date(item.data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                      {item.data.cover && (
                        <div class="rounded-lg overflow-hidden h-32 w-full">
                           <img 
                            src={item.data.cover}
                            alt={item.data.title} 
                            class="w-full h-full object-cover transform hover:scale-110 transition-duration-500"
                           />
                        </div>
                      )}
                   </div>

                   <!-- Content -->
                   <div class="sm:w-2/3">
                      <h3 
                        class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-3 group-hover:text-blue-600 transition-colors"
                        data-i18n-es={item.data.title}
                        data-i18n-en={item.data.title_en}
                      >
                        {item.data.title}
                      </h3>
                      <p 
                        class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                        data-i18n-es={item.data.description}
                        data-i18n-en={item.data.description_en}
                      >
                        {item.data.description}
                      </p>
                   </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Sidebar -->
      <div class="space-y-8">
        
        <!-- LinkedIn Widget (Sidebar Version) -->
        <div class="bg-gradient-to-br from-blue-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl p-6 border border-blue-100 dark:border-gray-700 shadow-sm sticky top-24">
            <div class="flex items-center gap-4 mb-4">
                <div class="bg-[#0077b5] p-3 rounded-lg text-white shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100" data-i18n-key="events.sidebar.follow">
                    Síguenos
                </h3>
            </div>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-6" data-i18n-key="events.sidebar.linkedinDesc">
                Mantente al día con nuestras últimas investigaciones y actividades en LinkedIn.
            </p>
            <a 
                href="https://www.linkedin.com/in/catedra-thin5g/" 
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex justify-center items-center gap-2 px-4 py-2.5 bg-[#0077b5] text-white text-sm font-semibold rounded-lg hover:bg-[#006097] transition-all shadow-sm hover:shadow-md"
            >
                <span data-i18n-key="events.sidebar.connect">Conectar en LinkedIn</span>
                <ArrowRight className="w-4 h-4" />
            </a>
        </div>

        <!-- Upcoming Events -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-100 dark:border-gray-700 shadow-sm">
            <h3
              class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-6 pb-2 border-b border-gray-100 dark:border-gray-700"
              data-i18n-key="events.sidebar.upcoming"
            >
              Próximos Eventos
            </h3>
            <div class="space-y-6">
              <div class="group">
                  <span class="inline-block px-2 py-1 rounded text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 mb-2" data-i18n-key="events.sidebar.tbd">
                    21 de mayo
                  </span>
                  <h4 class="text-base font-bold text-gray-900 dark:text-gray-100 group-hover:text-amber-600 transition-colors mb-2" data-i18n-key="events.sidebar.scienceWeek">
                    Feria de la Ciencia
                  </h4>
              </div>
            </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

