---
import { withBase } from "../utils/urls";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { ArrowDownRight, ArrowRight } from "lucide-react";
import HeroCarousel from "../components/HeroCarousel.astro";
import { SITE } from "../config";
import "../styles/home.css";

// Fetch Highlight Projects
const highlightIds = [
  "digital-twin-robotic-arm",
  "turtlebot3-autonomous",
  "autonomous-vehicles-5g",
];
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => highlightIds.includes(p.id))
  // Sort by order in highlightIds to maintain desired order
  .sort((a, b) => highlightIds.indexOf(a.id) - highlightIds.indexOf(b.id));

const events = (await getCollection("events"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Dynamic Carousel Images
import fs from "node:fs";
import path from "node:path";

const carouselDir = path.join(process.cwd(), "public", "Fotos", "About");
let carouselImages: string[] = [];

try {
  if (fs.existsSync(carouselDir)) {
    const files = fs.readdirSync(carouselDir);
    carouselImages = files
      .filter((file) => /\.(jpg|jpeg|png|webp|avif|svg)$/i.test(file))
      .map((file) => `/Fotos/About/${file}`);
  }
} catch (error) {
  console.error("Error reading carrusel images:", error);
}

// Fallback if no images found
if (carouselImages.length === 0) {
  carouselImages = ["/footer/GITPA.png"];
}

const openingPhoto = "/Fotos/About/IMG20221006090001.jpg";
if (carouselImages.includes(openingPhoto)) {
  carouselImages = [openingPhoto, ...carouselImages.filter((image) => image !== openingPhoto)];
}
---

<Layout title="Home">
  <section class="home-hero site-frame" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <h1 id="home-title" data-i18n-key="hero.title">{SITE.hero.title}</h1>
      <p data-i18n-key="hero.subtitle">{SITE.hero.subtitle}</p>
      <div class="home-actions">
        <a href={withBase("/projects")} class="home-action home-action-primary">
          <span data-i18n-key="hero.viewPubs">View Publications</span>
          <ArrowDownRight aria-hidden="true" size={18} />
        </a>
        <a href={withBase("/team")} class="home-action">
          <span data-i18n-key="hero.meetTeam">Meet the Team</span>
          <ArrowRight aria-hidden="true" size={18} />
        </a>
      </div>
    </div>

    <HeroCarousel images={carouselImages} />
  </section>

  <section class="home-section site-frame" aria-labelledby="featured-projects">
    <div class="home-section-heading">
      <h2 id="featured-projects" data-i18n-key="section.featuredProjects">Featured Projects</h2>
      <a href={withBase("/projects")} class="index-link">
        <span data-i18n-key="section.viewAll">View all</span>
        <ArrowRight aria-hidden="true" size={18} />
      </a>
    </div>

    <div class="featured-projects">
      {
        featuredProjects.map((project) => (
          <article class="featured-project">
            {project.data.cover && (
              <div class="project-photo">
                <img src={withBase(project.data.cover)} alt={project.data.title} loading="lazy" />
              </div>
            )}
            <h3 data-i18n-en={project.data.title} data-i18n-es={project.data.title_es}>
              {project.data.title}
            </h3>
            <div class="project-tags">
              {project.data.tags?.slice(0, 2).map((tag, index) => (
                <span data-i18n-en={tag} data-i18n-es={project.data.tags_es?.[index]}>
                  {tag}
                </span>
              ))}
            </div>
            <p data-i18n-en={project.data.summary} data-i18n-es={project.data.summary_es}>
              {project.data.summary}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-activities" aria-labelledby="latest-activities">
    <div class="home-section site-frame">
      <div class="home-section-heading">
        <h2 id="latest-activities" data-i18n-key="section.latestNews">Latest Activities</h2>
        <a href={withBase("/events")} class="index-link">
          <span data-i18n-key="section.viewAll">View all</span>
          <ArrowRight aria-hidden="true" size={18} />
        </a>
      </div>

      <div class="home-event-list">
        {
          events.map((item) => (
            <article class="home-event">
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString()}
              </time>
              {item.data.cover && (
                <img src={withBase(item.data.cover)} alt={item.data.title} loading="lazy" />
              )}
              <div class="home-event-copy">
                <h3 data-i18n-en={item.data.title_en} data-i18n-es={item.data.title}>
                  {item.data.title}
                </h3>
                <p data-i18n-en={item.data.description_en} data-i18n-es={item.data.description}>
                  {item.data.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
