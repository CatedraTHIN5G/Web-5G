---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { ArrowRight, Calendar } from "lucide-react";
import HeroCarousel from "../components/HeroCarousel.astro";
import { SITE } from "../config";

// Fetch Highlight Projects
const highlightIds = [
  "digital-twin-robotic-arm",
  "turtlebot3-autonomous",
  "autonomous-vehicles-5g",
];
const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => highlightIds.includes(p.id))
  // Sort by order in highlightIds to maintain desired order
  .sort((a, b) => highlightIds.indexOf(a.id) - highlightIds.indexOf(b.id));

const events = (await getCollection("events"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Dynamic Carousel Images
import fs from "node:fs";
import path from "node:path";

const carouselDir = path.join(process.cwd(), "public", "Fotos", "About");
let carouselImages: string[] = [];

try {
  if (fs.existsSync(carouselDir)) {
    const files = fs.readdirSync(carouselDir);
    carouselImages = files
      .filter((file) => /\.(jpg|jpeg|png|webp|avif|svg)$/i.test(file))
      .map((file) => `/Fotos/About/${file}`);
  }
} catch (error) {
  console.error("Error reading carrusel images:", error);
}

// Fallback if no images found
if (carouselImages.length === 0) {
  carouselImages = ["/assets/hero-real.jpg"];
}
---

<Layout title="Home">
  <!-- Hero Section -->
  <section
    class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden"
  >
    <!-- Background Image -->
    <HeroCarousel images={carouselImages} />

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl">
        <h1
          class="text-5xl font-extrabold text-white sm:text-6xl md:text-7xl mb-6 drop-shadow-lg leading-tight"
        >
          <span class="block xl:inline" data-i18n-key="hero.title"
            >{SITE.hero.title}</span
          >
        </h1>
        <p
          class="mt-4 text-xl text-gray-300 sm:max-w-2xl md:text-2xl drop-shadow-md"
          data-i18n-key="hero.subtitle"
        >
          {SITE.hero.subtitle}
        </p>
        <div class="mt-10 flex gap-4">
          <a
            href="/projects"
            class="flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-full text-black bg-white hover:bg-gray-100 transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.5)]"
            data-i18n-key="hero.viewPubs"
          >
            View Publications
          </a>
          <a
            href="/team"
            class="flex items-center justify-center px-8 py-4 border-2 border-white/30 text-lg font-medium rounded-full text-white hover:bg-white/10 transition-all duration-300 backdrop-blur-sm"
            data-i18n-key="hero.meetTeam"
          >
            Meet the Team
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div
      class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce text-white/50"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-16 bg-white dark:bg-black transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-gray-100"
          data-i18n-key="section.featuredProjects"
        >
          Featured Projects
        </h2>
        <a
          href="/projects"
          class="text-black hover:text-gray-600 dark:text-blue-400 dark:hover:text-blue-300 font-medium flex items-center gap-1 group"
        >
          <span data-i18n-key="section.viewAll">View all</span>
          <ArrowRight
            className="w-4 h-4 group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          featuredProjects.map((project) => (
            <div class="group bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 overflow-hidden hover:shadow-lg transition-all">
              {project.data.cover && (
                <div class="h-48 overflow-hidden bg-gray-100 dark:bg-gray-700">
                  <img
                    src={project.data.cover.src}
                    alt={project.data.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                </div>
              )}
              {!project.data.cover && (
                <div class="h-48 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 flex items-center justify-center">
                  <svg
                    class="w-12 h-12 text-blue-300 dark:text-blue-700/50"
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                  </svg>
                </div>
              )}
              <div class="p-6">
                <div class="flex flex-wrap gap-2 mb-3">
                  {project.data.tags?.slice(0, 2).map((tag, i) => (
                    <span
                      class="px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 border border-blue-100 dark:border-blue-800"
                      data-i18n-en={tag}
                      data-i18n-es={project.data.tags_es?.[i]}
                    >
                      {tag}
                    </span>
                  ))}
                </div>
                <h3 class="text-xl font-bold text-black dark:text-white group-hover:text-gray-600 dark:group-hover:text-blue-400 transition-colors mb-2 line-clamp-2">
                  <span
                    data-i18n-en={project.data.title}
                    data-i18n-es={project.data.title_es}
                  >
                    {project.data.title}
                  </span>
                </h3>
                <p
                  class="text-gray-600 dark:text-gray-300 line-clamp-3 text-sm"
                  data-i18n-en={project.data.summary}
                  data-i18n-es={project.data.summary_es}
                >
                  {project.data.summary}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest Activities -->
  <section class="py-16 bg-white dark:bg-black transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2
          class="text-3xl font-bold text-gray-900 dark:text-gray-100"
          data-i18n-key="section.latestNews"
        >
          Latest Activities
        </h2>
        <a
          href="/events"
          class="text-black hover:text-gray-600 dark:text-blue-400 dark:hover:text-blue-300 font-medium flex items-center gap-1 group"
        >
          <span data-i18n-key="section.viewAll">View all</span>
          <ArrowRight
            className="w-4 h-4 group-hover:translate-x-1 transition-transform"
          />
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          events.map((item) => {
            const link = `/events/${item.id.replace(/\.[^/.]+$/, "")}`;
            return (
              <div class="group bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 overflow-hidden hover:shadow-lg transition-all">
                {item.data.cover && (
                  <a href={link} class="block h-48 overflow-hidden">
                    <img
                      src={
                        typeof item.data.cover === "string"
                          ? item.data.cover
                          : item.data.cover.src
                      }
                      alt={item.data.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </a>
                )}
                <div class="p-6">
                  <div class="text-sm text-gray-500 dark:text-gray-400 mb-2 flex items-center gap-2">
                    <Calendar className="w-4 h-4" />
                    {item.data.date.toLocaleDateString()}
                  </div>
                  <h3 class="text-xl font-bold text-black dark:text-white group-hover:text-gray-600 dark:group-hover:text-blue-400 transition-colors mb-2 line-clamp-2">
                    <a
                      href={link}
                      data-i18n-en={item.data.title}
                      data-i18n-es={item.data.title_es}
                    >
                      {item.data.title}
                    </a>
                  </h3>
                  <p
                    class="text-gray-600 dark:text-gray-300 line-clamp-3 text-sm"
                    data-i18n-en={
                      item.data.description ||
                      (item.body || "").substring(0, 100)
                    }
                    data-i18n-es={item.data.description_es}
                  >
                    {item.data.description ||
                      (item.body || "").substring(0, 100)}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
