---
import { withBase } from "../../utils/urls";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { FileText, FileCode, ArrowLeft, Tag } from "lucide-react";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const { project } = Astro.props;
const { Content } = await render(project);

const {
    title,
    title_es,
    summary,
    summary_es,
    tags,
    tags_es,
    docUrl,
    codeUrl,
    cover,
    team,
} = project.data;

const lang = getLangFromUrl(Astro.url);
const displaySummary = lang === "es" && summary_es ? summary_es : summary;

// Map roles to i18n keys
const getRoleKey = (role: string) => {
    const map: Record<string, string> = {
        "Principal Investigator": "role.pi",
        Professor: "role.professor",
        "Associate Professor": "role.associate",
        "Assistant Professor": "role.assistant",
        Postdoc: "role.postdoc",
        "Research Assistant": "role.research_assistant",
        "PhD Student": "role.phd",
        "Master Student": "role.master",
        Undergraduate: "role.undergrad",
        Alumni: "role.alumni",
    };
    return map[role] || null;
};

// Fetch team members
const allTeam = await getCollection("team");
const projectTeam = team
    ? allTeam.filter((member) => team.includes(member.id))
    : [];

// Side-load Spanish content if available
// Assumption: Spanish file id is "{id}-es"
const allProjects = await getCollection("projects");
const spanishProject = allProjects.find((p) => p.id === `${project.id}-es`);
let ContentEs = null;
if (spanishProject) {
    const rendered = await render(spanishProject);
    ContentEs = rendered.Content;
}
---

<Layout title={title}>
    <div class="bg-gray-50 dark:bg-gray-900 min-h-screen pb-20">
        <!-- Header / Hero -->
        <div
            class="bg-white dark:bg-gray-800 border-b border-gray-100 dark:border-gray-700"
        >
            <div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
                <a
                    href={withBase("/projects")}
                    class="inline-flex items-center gap-2 text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 mb-6 transition-colors font-medium"
                >
                    <ArrowLeft className="w-4 h-4" />
                    <span data-i18n-key="projects.back">Back to Projects</span>
                </a>

                <div class="space-y-4">
                    {
                        tags && (
                            <div class="flex flex-wrap gap-2">
                                {tags.map((tag, index) => (
                                    <span
                                        class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 border border-blue-100 dark:border-blue-800"
                                        data-i18n-en={tag}
                                        data-i18n-es={tags_es?.[index]}
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )
                    }

                    <h1
                        class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight leading-tight"
                        data-i18n-en={title}
                        data-i18n-es={title_es}
                    >
                        {title}
                    </h1>

                    <p
                        class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-3xl"
                        data-i18n-en={summary}
                        data-i18n-es={summary_es}
                    >
                        {displaySummary}
                    </p>
                </div>
            </div>
        </div>

        {
            projectTeam.length > 0 && (
                <div class="max-w-4xl mx-auto px-4 mt-8">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
                        <span class="w-2 h-8 bg-indigo-600 rounded-full" />
                        <span data-i18n-key="projects.contributors">
                            Contributors
                        </span>
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {projectTeam.map((member) => (
                            <a
                                href={withBase(`/team#${member.id.replace(/\.[^/.]+$/, "")}`)}
                                class="flex items-center gap-4 p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 hover:shadow-md transition-all group"
                            >
                                <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-100 dark:bg-gray-700 border-2 border-white dark:border-gray-600 shadow-sm shrink-0">
                                    <img
                                        src={withBase(member.data.avatar)}
                                        alt={member.data.name}
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                        {member.data.name}
                                    </h4>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">
                                        <span
                                            data-i18n-key={getRoleKey(
                                                member.data.role,
                                            )}
                                        >
                                            {member.data.role}
                                        </span>
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            )
        }

        <div class="max-w-4xl mx-auto px-4 py-12">
            {
                cover && (
                    <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-700 mb-12">
                        <img
                            src={withBase(cover)}
                            alt={title}
                            class="w-full h-auto object-cover max-h-[500px]"
                        />
                    </div>
                )
            }

            <!-- Main Content -->
            <div
                class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-8 sm:p-12 mb-12"
            >
                <article
                    class="prose prose-lg dark:prose-invert prose-blue max-w-none i18n-content-en text-justify
                    prose-headings:font-bold
                    prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-200 dark:prose-h2:border-gray-700
                    prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-blue-600 dark:prose-h3:text-blue-400
                    prose-p:my-4 prose-li:my-2 prose-strong:text-gray-900 dark:prose-strong:text-gray-100"
                >
                    <Content />
                </article>

                {
                    ContentEs && ContentEs && (
                        <article
                            class="prose prose-lg dark:prose-invert prose-blue max-w-none i18n-content-es text-justify 
                        prose-headings:font-bold 
                        prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-200 dark:prose-h2:border-gray-700
                        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-blue-600 dark:prose-h3:text-blue-400
                        prose-p:my-4 prose-li:my-2 prose-strong:text-gray-900 dark:prose-strong:text-gray-100"
                        >
                            <ContentEs />
                        </article>
                    )
                }
            </div>

            <!-- Downloads Section -->
            <div
                class="bg-blue-50 dark:bg-blue-900/20 rounded-2xl p-8 border border-blue-100 dark:border-blue-800/50"
            >
                <h3
                    class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2"
                >
                    <span class="w-2 h-8 bg-blue-600 rounded-full"></span>
                    <span data-i18n-key="projects.resources"
                        >Project Resources</span
                    >
                </h3>

                <div class="grid sm:grid-cols-2 gap-4">
                    {
                        docUrl ? (
                            <a
                                href={withBase(docUrl)}
                                target="_blank"
                                download
                                class="group flex items-center justify-between p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-all"
                            >
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 rounded-lg group-hover:bg-red-100 dark:group-hover:bg-red-900/40 transition-colors">
                                        <FileText className="w-6 h-6" />
                                    </div>
                                    <div class="text-left">
                                        <div class="font-bold text-gray-900 dark:text-gray-100">
                                            <span data-i18n-key="projects.docs">
                                                Documentation
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">
                                            <span data-i18n-key="projects.downloadPdf">
                                                Download PDF
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        ) : (
                            <div class="flex items-center justify-between p-4 bg-gray-100 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 opacity-60 cursor-not-allowed">
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-gray-200 dark:bg-gray-700 text-gray-400 rounded-lg">
                                        <FileText className="w-6 h-6" />
                                    </div>
                                    <div class="text-left">
                                        <div class="font-bold text-gray-500 dark:text-gray-400">
                                            <span data-i18n-key="projects.docs">
                                                Documentation
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-400">
                                            <span data-i18n-key="projects.notAvailable">
                                                Not available
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )
                    }

                    {
                        codeUrl ? (
                            <a
                                href={withBase(codeUrl)}
                                target="_blank"
                                download
                                class="group flex items-center justify-between p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-all"
                            >
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-gray-900 dark:bg-gray-700 text-white dark:text-gray-200 rounded-lg group-hover:bg-gray-800 dark:group-hover:bg-gray-600 transition-colors">
                                        <FileCode className="w-6 h-6" />
                                    </div>
                                    <div class="text-left">
                                        <div class="font-bold text-gray-900 dark:text-gray-100">
                                            <span data-i18n-key="projects.source">
                                                Source Code
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-500 dark:text-gray-400">
                                            <span data-i18n-key="projects.downloadPy">
                                                Download .py
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        ) : (
                            <div class="flex items-center justify-between p-4 bg-gray-100 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700 opacity-60 cursor-not-allowed">
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-gray-200 dark:bg-gray-700 text-gray-400 rounded-lg">
                                        <FileCode className="w-6 h-6" />
                                    </div>
                                    <div class="text-left">
                                        <div class="font-bold text-gray-500 dark:text-gray-400">
                                            <span data-i18n-key="projects.source">
                                                Source Code
                                            </span>
                                        </div>
                                        <div class="text-sm text-gray-400">
                                            <span data-i18n-key="projects.notAvailable">
                                                Not available
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    /* Robust overrides for prose headers */
    .prose h2 {
        font-size: 1.875rem !important; /* 3xl */
        line-height: 2.25rem !important;
        margin-top: 3rem !important;
        margin-bottom: 1.5rem !important;
        padding-bottom: 0.5rem !important;
        border-bottom-width: 1px !important;
        border-bottom-style: solid !important;
        border-bottom-color: #e5e7eb !important; /* gray-200 */
        font-weight: 800 !important;
    }

    html.dark .prose h2 {
        border-bottom-color: #374151 !important; /* gray-700 */
    }

    .prose h3 {
        font-size: 1.25rem !important; /* xl */
        line-height: 1.75rem !important;
        margin-top: 2rem !important;
        margin-bottom: 1rem !important;
        color: #2563eb !important; /* blue-600 */
        font-weight: 700 !important;
    }

    html.dark .prose h3 {
        color: #60a5fa !important; /* blue-400 */
    }

    /* Force code blocks to be distinct boxes */
    /* Force code blocks (PRE tags) to be ALWAYS DARK "Terminal Style" */
    .prose pre {
        background-color: #0f172a !important; /* slate-900 (Dark) */
        color: #f1f5f9 !important; /* slate-100 (Light text) */
        padding: 1.25rem !important;
        border-radius: 0.5rem !important;
        margin-top: 1.5rem !important;
        margin-bottom: 1.5rem !important;
        border: 1px solid #334155 !important; /* slate-700 */
        overflow-x: auto !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2) !important;
    }

    /* Ensure no light mode override for Pre AND REMOVE BORDER IN DARK MODE */
    html.dark .prose pre {
        background-color: #0f172a !important;
        border: none !important; /* Clean look for dark mode */
    }

    /* --------------------------------------------------------- */

    /* Inline Code (CODE tags) - ADAPTIVE (Gray in light, Dark in dark) */
    .prose code {
        font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
            "Liberation Mono", "Courier New", monospace !important;
        font-size: 0.9em !important;

        /* Light Mode Default: Subtle Gray Box */
        background-color: #f1f5f9 !important; /* slate-100 */
        color: #0f172a !important; /* slate-900 */
        padding: 0.2rem 0.4rem !important;
        border-radius: 0.25rem !important;
        border: 1px solid #cbd5e1 !important; /* slate-300 */
    }

    /* Inline Code - Dark Mode Override */
    html.dark .prose code {
        background-color: #1e293b !important; /* slate-800 */
        color: #e2e8f0 !important; /* slate-200 */
        border-color: #334155 !important; /* slate-700 */
    }

    /* Remove background/padding from code INSIDE pre to avoid double-boxing (Crucial) */
    /* Remove background/padding from code INSIDE pre to avoid double-boxing (Crucial) */
    /* Must use high specificity to override html.dark .prose code */
    /* Target both light and dark overrides explicitly or just use high specificity chain */
    :is(html, .dark) .prose pre code,
    .prose pre code {
        background-color: transparent !important;
        padding: 0 !important;
        border: none !important;
        color: inherit !important;
        box-shadow: none !important; /* Ensure no shadow on inner code */
    }
</style>
<!-- Refresh Trigger: 1 -->
