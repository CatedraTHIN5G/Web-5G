---
import Layout from "../layouts/Layout.astro";
import { Mail, GraduationCap, BookOpen, Code, Info } from "lucide-react";
import { SITE } from "../config";
---

<Layout title="Join Us | Cátedra Thin5G">
  <!-- Hero / Introduction Section -->
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20 lg:pt-32">
    <div class="text-center mb-16">
      <h1
        class="text-4xl font-extrabold text-gray-900 dark:text-gray-100 mb-6"
        data-i18n-key="join.title"
      >
        Join Us
      </h1>
      <p
        class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed text-balance"
        data-i18n-key="join.subtitle"
      >
        We are always looking for motivated students to join our team. If you
        are interested in our research areas, please contact us!
      </p>
    </div>

    <!-- Student Cards Removed as per user request to avoid generic requirements -->

    <!-- Benefits Section (Why Join Us?) -->
    <div class="mb-24">
      <div
        class="bg-gradient-to-br from-indigo-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 rounded-3xl p-8 sm:p-12 border border-blue-100 dark:border-gray-700 relative overflow-hidden"
      >
        <!-- Background Elements -->
        <div
          class="absolute top-0 right-0 -mt-20 -mr-20 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-purple-400/20 rounded-full blur-3xl"
        >
        </div>

        <div class="relative z-10">
          <div class="text-center mb-12">
            <h2
              class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4"
              data-i18n-key="join.benefits.title"
            >
              Why Join Cátedra THIN5G?
            </h2>
            <p
              class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto"
              data-i18n-key="join.benefits.desc"
            >
              We are a reference in 5G technology. We offer access to unique
              equipment, direct connection with the industry, and a young and
              dynamic multidisciplinary environment.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            <!-- Lab -->
            <div
              class="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm p-6 rounded-xl border border-white/50 dark:border-gray-700 text-center"
            >
              <div
                class="w-12 h-12 bg-blue-100 dark:bg-blue-900/40 rounded-full flex items-center justify-center mb-4 mx-auto text-blue-600 dark:text-blue-400"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M2 12h20"></path><path
                    d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"></path><path
                    d="M12 2a4 4 0 0 1 4 4v6H8V6a4 4 0 0 1 4-4Z"></path></svg
                >
              </div>
              <h3
                class="font-bold text-lg text-gray-900 dark:text-gray-100"
                data-i18n-key="join.benefits.item1"
              >
                State-of-the-art 5G Lab
              </h3>
            </div>

            <!-- Industry -->
            <div
              class="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm p-6 rounded-xl border border-white/50 dark:border-gray-700 text-center"
            >
              <div
                class="w-12 h-12 bg-purple-100 dark:bg-purple-900/40 rounded-full flex items-center justify-center mb-4 mx-auto text-purple-600 dark:text-purple-400"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><rect width="20" height="14" x="2" y="3" rx="2"></rect><line
                    x1="8"
                    x2="16"
                    y1="21"
                    y2="21"></line><line x1="12" x2="12" y1="17" y2="21"
                  ></line></svg
                >
              </div>
              <h3
                class="font-bold text-lg text-gray-900 dark:text-gray-100"
                data-i18n-key="join.benefits.item2"
              >
                Industry Connection
              </h3>
            </div>

            <!-- Projects -->
            <div
              class="bg-white/60 dark:bg-gray-800/60 backdrop-blur-sm p-6 rounded-xl border border-white/50 dark:border-gray-700 text-center"
            >
              <div
                class="w-12 h-12 bg-green-100 dark:bg-green-900/40 rounded-full flex items-center justify-center mb-4 mx-auto text-green-600 dark:text-green-400"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  ></path></svg
                >
              </div>
              <h3
                class="font-bold text-lg text-gray-900 dark:text-gray-100"
                data-i18n-key="join.benefits.item3"
              >
                Real Impact Projects
              </h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Apply Process & Contact (3 Columns) -->
    <div class="grid lg:grid-cols-3 gap-8 mb-16">
      <!-- How to Apply -->
      <div
        class="bg-gray-900 dark:bg-gray-800 rounded-3xl p-8 text-white relative overflow-hidden flex flex-col justify-between"
      >
        <div class="relative z-10">
          <div
            class="w-12 h-12 bg-gray-700 rounded-xl flex items-center justify-center mb-6 text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
              ></path><circle cx="8.5" cy="7" r="4"></circle><line
                x1="20"
                x2="20"
                y1="8"
                y2="14"></line><line x1="23" x2="17" y1="11" y2="11"
              ></line></svg
            >
          </div>
          <h2 class="text-2xl font-bold mb-4" data-i18n-key="join.howToApply">
            How to Apply
          </h2>
          <p
            class="text-gray-300 leading-relaxed"
            data-i18n-key="join.applicationText"
          >
            Scholarship offers are managed by the Fundación Universidad de
            Oviedo (FUO) and are typically published in the two semesters.
          </p>
        </div>
      </div>

      <!-- TFG/TFM/Thesis Box -->
      <div
        class="bg-white dark:bg-gray-700/50 rounded-3xl p-8 border border-gray-200 dark:border-gray-600 relative overflow-hidden flex flex-col justify-between"
      >
        <div class="relative z-10">
          <div
            class="w-12 h-12 bg-blue-100 dark:bg-blue-900/40 rounded-xl flex items-center justify-center mb-6 text-blue-600 dark:text-blue-400"
          >
            <BookOpen className="w-6 h-6" />
          </div>
          <h2
            class="text-2xl font-bold text-gray-900 dark:text-white mb-4"
            data-i18n-key="join.tfg.title"
          >
            TFG / TFM / Thesis
          </h2>
          <p
            class="text-gray-600 dark:text-gray-300 mb-8 leading-relaxed"
            data-i18n-key="join.tfg.text"
          >
            Contact professors associated with the Chair for more details.
          </p>

          <a
            href="/team"
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 font-bold hover:gap-3 transition-all"
          >
            <span data-i18n-key="join.tfg.btn">Meet the Faculty</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                points="12 5 19 12 12 19"></polyline></svg
            >
          </a>
        </div>
      </div>

      <!-- Doubts / Contact -->
      <div
        class="bg-blue-600 dark:bg-blue-900 rounded-3xl p-8 text-white relative overflow-hidden flex flex-col justify-between"
      >
        <div class="relative z-10">
          <div
            class="w-12 h-12 bg-blue-500/50 rounded-xl flex items-center justify-center mb-6 text-white"
          >
            <Info className="w-6 h-6" />
          </div>
          <h2 class="text-2xl font-bold mb-4" data-i18n-key="join.doubts">
            Any questions?
          </h2>
          <p
            class="text-blue-100 mb-6 leading-relaxed"
            data-i18n-key="join.doubtsText"
          >
            Write to us at:
          </p>

          <a
            href={`mailto:${SITE.email}`}
            class="inline-flex items-center gap-3 bg-white text-blue-900 px-6 py-3 rounded-xl font-bold hover:bg-blue-50 transition-colors transform hover:-translate-y-1 duration-200"
          >
            <Mail className="w-5 h-5" />
            <span>{SITE.email}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
