---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Calendar, ArrowLeft } from "lucide-react";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((item) => ({
    params: { slug: item.id.replace(/\.[^/.]+$/, "") },
    props: { item },
  }));
}

const { slug } = Astro.params;
let { item } = Astro.props;

if (!item && slug) {
  try {
    item = (await getEntry("events", slug)) as any;
  } catch (e) {
    console.error(`Error fetching event for slug: ${slug}`, e);
  }
}

if (!item) {
  return Astro.redirect("/404");
}

const { Content } = await render(item);
---

<Layout title={item.data.title}>
  <article class="max-w-4xl mx-auto px-4 py-12 sm:py-20">
    <a
      href="/events"
      class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 mb-8 transition-colors"
    >
      <ArrowLeft className="w-4 h-4 mr-1" /> Back to Events
    </a>

    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">{item.data.title}</h1>

      <div class="flex items-center gap-4 text-gray-500 mb-8">
        <div class="flex items-center gap-2">
          <Calendar className="w-4 h-4" />
          <time
            >{
              new Date(item.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }</time
          >
        </div>
      </div>

      {
        item.data.cover && (
          <div class="w-full h-64 sm:h-96 rounded-2xl overflow-hidden bg-gray-100 mb-8">
            <img
              src={
                typeof item.data.cover === "string"
                  ? item.data.cover
                  : item.data.cover.src
              }
              alt={item.data.title}
              class="w-full h-full object-cover"
            />
          </div>
        )
      }

      {
        item.data.description && (
          <p class="text-xl text-gray-600 leading-relaxed border-l-4 border-blue-500 pl-4 italic">
            {item.data.description}
          </p>
        )
      }
    </header>

    <div class="prose prose-lg prose-blue max-w-none text-gray-700">
      <Content />
    </div>
  </article>
</Layout>
