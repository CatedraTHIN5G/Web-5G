---
import { withBase } from "../utils/urls";
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { ui } from "../i18n/ui";
import { FileText, Download } from "lucide-react";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Default server-side render
const researchLines = t("researchLines.list") as unknown as string[];
// Data for client-side updates
const researchLinesEn = ui.en["researchLines.list"];
const researchLinesEs = ui.es["researchLines.list"];
---

<Layout title={t("researchLines.title")}>
    <div class="max-w-4xl mx-auto px-4 py-12 sm:py-20 ">
        <div class="page-masthead">
            <h1
                class="text-4xl font-extrabold text-gray-900 dark:text-gray-100 mb-6"
                data-i18n-key="researchLines.title"
            >
                {t("researchLines.title")}
            </h1>
            <p
                class="text-xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed text-balance"
                data-i18n-key="researchLines.intro"
            >
                {t("researchLines.intro")}
            </p>
        </div>

        <div
            class="page-panel bg-white dark:bg-gray-800 p-8 sm:p-12 shadow-xl border border-gray-100 dark:border-gray-700"
        >
            <ul id="research-lines-list" class="space-y-6">
                {
                    researchLines.map((line) => (
                        <li class="flex items-start gap-4">
                            <div class="mt-1 bg-blue-100 dark:bg-blue-900/50 p-2 rounded-lg text-blue-600 dark:text-blue-400 shrink-0">
                                <FileText className="w-5 h-5" />
                            </div>
                            <span class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
                                {line}
                            </span>
                        </li>
                    ))
                }
            </ul>

            <div class="mt-12 text-center">
                <a
                    href={withBase("/research-lines.pdf")}
                    download
                    class="inline-flex items-center gap-3 bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-xl font-bold transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-blue-500/25"
                >
                    <Download className="w-5 h-5" />
                    <span data-i18n-key="researchLines.downloadPdf"
                        >{t("researchLines.downloadPdf")}</span
                    >
                </a>
            </div>
        </div>
    </div>
</Layout>

<script define:vars={{ researchLinesEn, researchLinesEs }}>
    const listContainer = document.getElementById("research-lines-list");

    function updateList(lang) {
        if (!listContainer) return;
        const list = lang === "es" ? researchLinesEs : researchLinesEn;

        // We only update if the list exists and has content
        if (Array.isArray(list)) {
            listContainer.innerHTML = list
                .map(
                    (line) => `
            <li class="flex items-start gap-4">
              <div class="mt-1 bg-blue-100 dark:bg-blue-900/50 p-2 rounded-lg text-blue-600 dark:text-blue-400 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
              </div>
              <span class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
                ${line}
              </span>
            </li>
        `,
                )
                .join("");
        }
    }

    // Listen for language changes from Layout.astro
    window.addEventListener("language-change", (e) => {
        updateList(e.detail.lang);

        // Also update download button manually if needed?
        // No, data-i18n-key handles the inner text of the span.
    });

    // Initial check
    const savedLang = localStorage.getItem("preferred-lang") || "en";
    if (savedLang === "es") {
        updateList("es");
    }
</script>
