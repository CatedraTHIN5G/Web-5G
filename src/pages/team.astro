---
import Layout from "../layouts/Layout.astro";
import TeamCard from "../components/TeamCard.astro";
import TeamFilters from "../components/TeamFilters.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const allMembers = await getCollection("team");

// Define groups based on user request
const groups = [
  {
    id: "faculty",
    titleKey: "team.professor",
    roles: [
      "Principal Investigator",
      "Professor",
      "Associate Professor",
      "Assistant Professor",
    ],
  },
  {
    id: "researcher",
    titleKey: "team.researcher",
    roles: ["Postdoc", "PhD Student", "Research Assistant"],
  },
  {
    id: "student",
    titleKey: "team.student",
    roles: ["Master Student", "Undergraduate", "Student"],
  },
];

const getRolePriority = (role: string) => {
  const priorities: Record<string, number> = {
    "Principal Investigator": 0,
    Professor: 1,
    "Associate Professor": 2,
    "Assistant Professor": 3,
    Postdoc: 4,
    "PhD Student": 5,
    "Research Assistant": 5, // Same priority as PhD for alpha sort
    "Master Student": 7,
    Undergraduate: 7, // Same priority as Master for alpha sort
    Student: 7, // Same priority for alpha sort
    Alumni: 99,
  };
  return priorities[role] ?? 99;
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const roleToKey: Record<string, string> = {
  "Principal Investigator": "role.pi",
  Professor: "role.professor",
  "Associate Professor": "role.associate",
  "Assistant Professor": "role.assistant",
  Teacher: "role.assistant",
  "Postdoctoral Researcher": "role.postdoc",
  Postdoc: "role.postdoc",
  "Research Assistant": "role.research_assistant",
  "PhD Student": "role.phd",
  "Master Student": "role.master",
  "Graduate Student": "role.master",
  Undergraduate: "role.undergrad",
  Student: "role.student",
  "Former Member": "role.alumni",
  Alumni: "role.alumni",
};

// Group members
const groupedMembers = groups.reduce(
  (acc, group) => {
    const members = allMembers
      .filter((m) => group.roles.includes(m.data.role))
      .sort((a, b) => {
        // Sort by Role Priority first (e.g. Prof before Assoc Prof)
        const roleDiff =
          getRolePriority(a.data.role) - getRolePriority(b.data.role);
        if (roleDiff !== 0) return roleDiff;

        // Then sort alphabetically by surname
        const getSurname = (fullName: string) => {
          const name = fullName.trim();
          /* Exceptions for known compound first names */
          if (name.startsWith("Álvaro Javier")) return "Fernández De la Concha";
          if (name.startsWith("Carmen Covadonga")) return "Blanco González";
          if (name.startsWith("Luis Fernando")) return "Herrán Ontañón";

          /* Default: Assume first word is name, rest is surname */
          const parts = name.split(" ");
          return parts.length > 1 ? parts.slice(1).join(" ") : name;
        };

        return getSurname(a.data.name).localeCompare(getSurname(b.data.name));
      })
      .map((member) => {
        // Translate the role for the card
        const originalRole = member.data.role;
        const translatedRole = roleToKey[originalRole]
          ? t(roleToKey[originalRole] as any)
          : originalRole;
        // Clone and override role with translated version for display
        // We can't easily mutate the immutable content object, so we'll pass the translated role separately to TeamCard
        // Or simpler: We modify the member object structure just for the template if possible, or better:
        // Let's pass 'translatedRole' as a prop to TeamCard.
        return { ...member, translatedRole };
      });

    if (members.length > 0) {
      acc.push({
        ...group,
        members,
      });
    }
    return acc;
  },
  [] as Array<{
    id: string;
    titleKey: string;
    roles: string[];
    members: Array<(typeof allMembers)[0] & { translatedRole: string }>;
  }>,
);
---

<Layout title="Team">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1
        class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4"
        data-i18n-key="team.title"
      >
        Our Team
      </h1>
      <p
        class="text-lg text-gray-600 dark:text-gray-400"
        data-i18n-key="team.subtitle"
      >
        Meet the researchers and students behind our innovations.
      </p>
    </div>

    <TeamFilters />

    <div class="space-y-20">
      {
        groupedMembers.map((group) => (
          <section data-group={group.id}>
            <h2
              class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8 pl-4 border-l-4 border-blue-600"
              data-i18n-key={group.titleKey}
            >
              {/* Fallback text if JS doesn't replace it immediately, though i18n script should handle it */}
              {group.id === "faculty"
                ? "Professors"
                : group.id === "master"
                  ? "Master Students"
                  : group.id === "undergrad"
                    ? "Undergraduate Students"
                    : ""}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
              {group.members.map((member) => (
                <div
                  class="team-card-wrapper"
                  data-status={member.data.status || "inactive"}
                >
                  <TeamCard
                    member={member}
                    roleOverride={member.translatedRole}
                  />
                </div>
              ))}
            </div>
          </section>
        ))
      }

      {
        allMembers.length === 0 && (
          <p
            class="text-gray-500 dark:text-gray-400 text-center py-12"
            data-i18n-key="team.noMembers"
          >
            No team members found. Add markdown files to src/content/team/
          </p>
        )
      }
    </div>
  </div>
</Layout>
